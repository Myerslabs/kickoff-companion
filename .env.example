# Kickoff Companion settings.
# You do not have to edit this file: on the first start the browser opens a setup page that asks for the
# key and the team and writes them here (.env, which git ignores). Everything below has a working default.
# Every value is validated at startup. A bad value stops the server with a message that names it.

# The CFBD key. Get one free at https://collegefootballdata.com/key. The setup page fills it in.
CFBD_API_KEY=

# Your team and its conference, spelled as CFBD spells them. The setup page fills them in from CFBD's
# list; the mascot, colors and abbreviation come from CFBD too.
TEAM=
CONFERENCE=

# The season to follow. Left out, it follows the calendar: this year from March on, last year in
# January and February (bowls and the title game).
# SEASON=2026

# Optional. Your school's own athletics news feed (RSS or Atom), shown with the national headlines.
# TEAM_FEED_URL=https://example.edu/rss?path=football

# Server. HOST 0.0.0.0 listens on every interface so the tablet can connect over Wi-Fi.
# PORT is 1 to 65535. With PORT=80 the tablet URL needs no port, e.g. http://football.localdomain
HOST=0.0.0.0
PORT=8642

# Optional. A DNS name the tablet can use instead of the IP address, for example
# football.localdomain (added as a local DNS record on the router). Leave blank to show the IP.
# The name also goes on the HTTPS certificate, which is re-issued automatically when it changes.
LAN_HOSTNAME=

# The name the server announces on the home network, so phones and tablets can open
# https://kickoff.local:8642 with no router setup (mDNS, the way printers are found). Change it if two
# installs share a network; set it to off to announce nothing. It goes on the certificate too.
MDNS_NAME=kickoff

# HTTPS on the home network. Off (the default): phones and tablets open http://kickoff.local:8642 with
# nothing to install. On: the server makes its own certificate authority, and every device must trust
# it once from the /setup page. For HTTPS without that step, see docs/05-SETUP.md (Tailscale).
HTTPS=off

# Kickoff times are shown in this IANA time zone.
TIMEZONE=America/New_York

# CFBD quota guard. The budget is replaced by the live monthly limit from CFBD once the key
# has been checked (the Free tier is 1,000 calls a month). QUOTA_HARD_STOP_PCT must be 50 to 97.
MONTHLY_CALL_BUDGET=30000
QUOTA_HARD_STOP_PCT=90

# Live polling interval in seconds. Minimum 8, maximum 120.
LIVE_POLL_SECONDS=12

# Optional. Your team's radio, in order, as a JSON list on one line. "kind" is "stream" (an audio
# URL the app plays with play and pause), "embed" (the station's player page inside the app), or
# "link" (opens a new tab). Use the station's own published player or stream address.
# Easier: add stations for any of your teams in the app, Settings, Radio stations. These come first.
# RADIO_SOURCES=[{"name": "Station web player", "kind": "embed", "url": "https://example.com/player"}]

# Logging. DEBUG, INFO, WARNING, or ERROR. Files rotate in logs/ (5 MB x 5).
LOG_LEVEL=INFO

# Optional folders, relative to the project root unless absolute.
# LOG_DIR=logs
# DATA_DIR=data

# Optional. Where CFBD lives. Point it at a dead address to rehearse an outage.
# CFBD_BASE_URL=https://api.collegefootballdata.com
